<Project>
  
  <!-- Import the root Directory.Packages.props if it exists (for monorepo builds) -->
  <!-- When building standalone, this import is skipped gracefully -->
  <PropertyGroup>
    <ParentPackagesPropsPath>$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))</ParentPackagesPropsPath>
  </PropertyGroup>
  <Import Project="$(ParentPackagesPropsPath)" Condition="'$(ParentPackagesPropsPath)' != ''" />
  
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Define package versions only when parent doesn't exist (standalone builds) -->
  <ItemGroup Condition="'$(ParentPackagesPropsPath)' == ''">
    <!-- Project Dependencies -->
    <PackageVersion Include="Baubit.Tasks" Version="2025.49.1" />
    <PackageVersion Include="Baubit.Collections" Version="2025.48.2" />
    <PackageVersion Include="Baubit.Identity" Version="2025.51.1" />
    <PackageVersion Include="Baubit.Configuration" Version="2026.2.1" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.5" />
    
    <!-- Benchmark Dependencies -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.4.0" />
    
    <!-- Test Dependencies -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
